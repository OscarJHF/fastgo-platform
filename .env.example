# FASTGO â€” Variables de Entorno de Produccion (Ejemplo)
# Copia este archivo a .env y asigna valores reales seguros.
# NUNCA subas el archivo .env real al repositorio Git.

# Base de Datos PostgreSQL de Produccion
DB_NAME=fastgo_prod
DB_USERNAME=fastgo_user
DB_PASSWORD=IngresaAquiUnaContrasenaSeguraDeAlMenos16Caracteres

# Seguridad JWT (Cadena aleatoria de al menos 64 caracteres)
JWT_SECRET=IngresaAquiUnSecretoJWTSeguroDeAlMenos64CaracteresRandom1234567890

# OrÃ­genes Permitidos CORS (Separados por coma)
CORS_ALLOWED_ORIGINS=https://fastgo.pages.dev,http://localhost:5173

# Dominio para Certificado SSL en Caddy (deja localhost si no tienes dominio)
DOMAIN_NAME=localhost