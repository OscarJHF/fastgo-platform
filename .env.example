# Copy this to .env and configure your production values.
# NEVER commit .env with real secrets to Git.

# Database
DB_NAME=fastgo
DB_USERNAME=fastgo_user
DB_PASSWORD=your_secure_db_password_here

# Security
JWT_SECRET=your_base64_or_random_secret_at_least_32_characters_long
CORS_ALLOWED_ORIGINS=https://fastgo.pages.dev,http://localhost:5173

# Domain / Reverse Proxy (Oracle Cloud VM Public IP or Domain)
DOMAIN_NAME=api.fastgo.example.com